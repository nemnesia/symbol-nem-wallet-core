{
  "name": "@nemnesia/symbol-nem-wallet-core",
  "version": "0.1.0",
  "description": "Synchronous Symbol and NEM wallet core facade",
  "author": "ccHarvestasya",
  "homepage": "https://github.com/nemnesia/symbol-nem-wallet-core#readme",
  "bugs": {
    "url": "https://github.com/nemnesia/symbol-nem-wallet-core/issues"
  },
  "keywords": [
    "symbol",
    "nem",
    "wallet",
    "wallet-core",
    "cryptography",
    "webassembly",
    "napi"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemnesia/symbol-nem-wallet-core.git",
    "directory": "packages/wallet-core"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/wasm/index.cjs",
  "module": "./dist/wasm/index.mjs",
  "codegenConfig": {
    "name": "SymbolNemWalletCoreSpec",
    "type": "modules",
    "jsSrcsDir": "src/react-native",
    "android": {
      "javaPackageName": "com.nemnesia.symbolnemwalletcore"
    },
    "ios": {
      "modulesProvider": {
        "NativeSymbolNemWalletCore": "NativeSymbolNemWalletCoreProvider"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/react-native/index.js",
      "node-addons": {
        "import": "./dist/node/index.mjs",
        "require": "./dist/node/index.cjs"
      },
      "default": {
        "import": "./dist/wasm/index.mjs",
        "require": "./dist/wasm/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "src/react-native",
    "react-native.config.cjs",
    "cpp",
    "android",
    "ios",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
